# Copy this file to .env. Keep secret values out of Git.

# Local services
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
BROWSER_WORKER_PORT=8010
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Alibaba Cloud Model Studio / Bailian. Leave the key empty for audited fallback mode.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.2
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=1

# Literature, metadata, materials, and repository integrations
OPENALEX_EMAIL=
CROSSREF_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
MAX_PAPERS=6
MATERIALS_PROJECT_API_KEY=
GITHUB_TOKEN=

# Workflow and local persistence
DATA_DIR=data
BROWSER_WORKER_URL=http://browser-worker:8010
WORKFLOW_ENGINE=langgraph

# Windows/WSL-friendly frontend watching
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
NEXT_PUBLIC_API_BASE=http://localhost:8000
